# EditorConfig: padroniza a formatação básica entre editores e IDEs.
# Referência: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java e XML (incluindo o pom.xml) seguem a indentação de 4 espaços usual no ecossistema Java.
[*.{java,xml}]
indent_size = 4

# No Markdown, dois espaços no fim da linha representam uma quebra de linha intencional.
[*.md]
trim_trailing_whitespace = false

# Scripts do Windows precisam de CRLF para funcionar corretamente (ex.: mvnw.cmd).
[*.{cmd,bat}]
end_of_line = crlf
