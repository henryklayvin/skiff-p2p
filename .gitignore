# ------------------------------------------------------------
# Backend (Java / Maven)
# ------------------------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
hs_err_pid*.log

# ------------------------------------------------------------
# Frontend (Node / Vite)
# ------------------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Relatórios do Playwright
test-results/
playwright-report/
playwright/.cache/

# ------------------------------------------------------------
# Segredos e configuração local
# Nunca versionar segredos (ex.: segredo compartilhado do TURN).
# Arquivos de exemplo devem usar o sufixo ".exemplo" e podem ser versionados.
# ------------------------------------------------------------
.env
.env.*
!.env.exemplo
*.local

# Certificados locais para HTTPS em desenvolvimento (ex.: gerados com mkcert)
*.pem
*.key
*.crt
*.p12

# ------------------------------------------------------------
# IDEs e editores
# ------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ------------------------------------------------------------
# Sistemas operacionais
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
logs/
*.log

# ------------------------------------------------------------
# Claude Code: configurações locais e pessoais
# ------------------------------------------------------------
.claude/settings.local.json
